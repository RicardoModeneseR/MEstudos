# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Sem essas variáveis o app roda em "modo local".
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave pública VAPID para notificações push (gere com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=
